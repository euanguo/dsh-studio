{
  "name": "@dsh-studio/sidebar-desktop",
  "version": "0.1.2",
  "description": "Desktop add-on for the DSH Studio sidebar: Electron webview browser",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@dsh-studio/sidebar"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/client.js.map"
  ],
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dshStudio": {
    "clientDependencies": [
      "@dsh-studio/shared",
      "@dsh-studio/sidebar"
    ]
  }
}
