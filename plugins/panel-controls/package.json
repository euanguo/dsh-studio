{
  "name": "@oh-dsh/panel-controls",
  "version": "0.1.4",
  "description": "Sidebar and resizable bottom-panel controls for Oh-DSH Desktop",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/client.js.map"
  ],
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@oh-dsh/shared": "workspace:*"
  }
}
