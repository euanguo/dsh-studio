{
  "name": "@dsh-studio/sidebar",
  "version": "0.1.2",
  "description": "Extensible DSH Studio side panel with workspace and desktop tools",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./client/contract": {
      "types": "./src/client/contract.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./client/i18n": {
      "types": "./src/client/i18n.ts",
      "default": "./dist/client.js"
    },
    "./client/surfaces-types": {
      "types": "./src/client/surfaces/types.ts",
      "default": "./dist/client.js"
    },
    "./client/types": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots",
        "@dsh-studio/panel-controls",
        "@dsh-studio/pinned-summary"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/client.js.map"
  ],
  "devDependencies": {
    "@pierre/diffs": "^1.3.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@dsh-studio/shared": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "mermaid": "^11.16.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "@dsh-studio/panel-controls": "workspace:*",
    "@dsh-studio/pinned-summary": "workspace:*"
  }
}
