{
  "description": "ROOT aggregate: every structural cut in this refactor is proven by symbol/file absence. Union of the decisive markers across all branches.",
  "scan": [
    "plugins/sidebar/src/**",
    "plugins/plugin-marketplace/src/**",
    "plugins/desktop-left-rail/src/**",
    "plugins/panel-controls/src/**",
    "plugins/pinned-summary/src/**",
    "src/main.ts",
    "src/update-manager.ts",
    "src/client.ts"
  ],
  "allowFiles": ["**/dsh-dom.ts"],
  "forbidFiles": [
    "plugins/errorMessage-sweep.list",
    "scripts/smoke-runtime.mjs"
  ],
  "forbid": [
    { "pattern": "acquireOpenPathPatch", "reason": "openPath hijack absorbed by pipeline" },
    { "pattern": "claimRightPanel|applyRightPanel|previewRightPanel", "reason": "footprint coordination owned by LayoutService" },
    { "pattern": "installHeroBranding", "reason": "branding observer deleted; identity single-sourced" },
    { "pattern": "euanguo/dsh-studio-app", "reason": "repository identity comes from desktop-identity module" },
    { "pattern": "\\btransitioning\\b", "reason": "lifecycle booleans replaced by controller state machine" },
    { "pattern": "// // unwired-capability", "reason": "marker format normalized" }
  ]
}
