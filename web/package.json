{
  "name": "@dsh-studio/web",
  "version": "0.1.4",
  "description": "DSH Studio Web: a packaged DeepSeek Harness browser runtime with DSH Studio plugin capabilities",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./dist/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/client.js.map",
    "dist/cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@dsh-studio/desktop-skins",
        "@dsh-studio/pinned-summary",
        "@dsh-studio/sidebar",
        "@dsh-studio/panel-controls"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dshStudio": {
    "clientDependencies": [
      "@dsh-studio/shared"
    ]
  }
}
